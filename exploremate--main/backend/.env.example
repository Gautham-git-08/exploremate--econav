# ExploreMate - Environment Variables (Backend)
FLASK_ENV=development
PORT=5000

# AI & Map API Keys (Backend-only, never exposed to client)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional 3rd Party Keys (Graceful fallbacks in place when missing)
GOOGLE_TRANSLATE_KEY=
GOOGLE_PLACES_KEY=
ORS_KEY=

# App Feature Flags
FEATURE_CHAPTERS=True
